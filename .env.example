# Copy to .env and adjust. docker-compose reads these.

# --- Hugging Face (for the gated biomedical NER model; optional otherwise) ---
HF_TOKEN=

# --- Local LLM (default: Ollama). Change the model to any you've pulled. ---
LLM_MODEL=qwen2.5:3b-instruct

# --- Embedding model (biomedical sentence embedder) ---
EMBED_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# --- To use an API LLM instead of local Ollama, set these in the api service env:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
